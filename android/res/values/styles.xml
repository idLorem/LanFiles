<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="App" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:alertDialogTheme">@style/Dialog</item>
    </style>
    <style name="Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/layer</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
    </style>
    <color name="bg">#202020</color>
    <color name="layer">#2B2B2B</color>
    <color name="accent">#60CDFF</color>
    <color name="launcher_bg">#191919</color>
</resources>
